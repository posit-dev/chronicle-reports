FROM rocker/r-ver:4

RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN install2.r --error rsconnect renv remotes

WORKDIR /workspace

COPY DESCRIPTION NAMESPACE ./
RUN Rscript -e 'remotes::install_local(".", dependencies = TRUE, upgrade = "never")'

COPY . .

CMD ["Rscript", "-e", "\
  options(repos = c(CRAN = 'https://p3m.dev/cran/latest')); \
  app_dirs <- c('inst/apps/connect', 'inst/apps/workbench'); \
  for (app_dir in app_dirs) { \
    message('Processing: ', app_dir); \
    renv::snapshot(project = app_dir, prompt = FALSE, force = TRUE); \
    rsconnect::writeManifest(appDir = app_dir); \
  } \
"]
